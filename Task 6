// binary search tree
#include <iostream>
#include <string>

using namespace std;

class Tree {
public:
    int value;
    Tree* left = nullptr;
    Tree* right = nullptr;

    Tree(int v) {
        value = v;   
    }

    void insert(int v) { 
        if (v < value) {
            if (left == nullptr) left = new Tree(v);
            else left->insert(v);
        } else if (v > value) {
            if (right == nullptr) right = new Tree(v);
            else right->insert(v);
        }
    }

    bool search(int v) {
        if (v == value) return true;
        if (v < value)  return left  != nullptr && left->search(v);
        else            return right != nullptr && right->search(v);
    }

    void displayInOrder() {
        if (left)  left->displayInOrder();
        cout << value << " ";
        if (right) right->displayInOrder();
    }

    void displayPreOrder() {
        cout << value << " ";
        if (left)  left->displayPreOrder();
        if (right) right->displayPreOrder();
    }
};

int main() {
    int order[] = {4, 2, 6, 1, 3, 5, 7};

    Tree* root = new Tree(order[0]);

    for (int i = 1; i < 7; i++) {
        root->insert(order[i]);
    }

    cout << "In-order (sorted): ";
    root->displayInOrder();
    cout << endl;

    cout << "Pre-order (shows structure): ";
    root->displayPreOrder();
    cout << endl;

    cout << "Search 5: " << (root->search(5) ? "found" : "not found") << endl;
    cout << "Search 9: " << (root->search(9) ? "found" : "not found") << endl;

    return 0;
}
